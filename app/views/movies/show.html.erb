<div class="max-w-5xl mx-auto flex gap-4 p-10">
  <!-- Left: Movie Title & Poster -->
  <div class="w-1/3 shrink-0">
    <h1 class="text-3xl font-bold mb-5"><%= @movie.title %></h1>

    <%= image_tag @movie.poster_url, class: "w-full rounded-xl" %>
  </div>

  <!-- Right: Movie Details -->
  <div class="flex-1 space-y-4 pt-10">
    <p><%= @movie.description %></p>

    <p><strong>Duration:</strong> <%= @movie.duration %></p>
    <p><strong>Release Date:</strong> <%= @movie.release_date %></p>
    <p><strong>Popularity:</strong> <%= @movie.popularity %></p>
    <p><strong>Budget:</strong> <%= @movie.budget %></p>
    <p><strong>Average Vote:</strong> <%= @movie.average_vote %></p>
    <p><strong>Total Votes:</strong> <%= @movie.total_votes %></p>

  </div>
</div>

<!-- Review Section -->
<div class="max-w-5xl mx-auto px-10 pb-10">
  <div class="mt-8 border-t border-gray-200 pt-6">

    <h2 class="text-2xl font-bold mb-5">Write a Review</h2>

    <% if current_user %>
      <%= form_with model: [@movie, Review.new] do |form| %>
        <div class="space-y-4">

          <div>
            <%= form.label :content, "Your Review", class: "block mb-2 font-medium" %>

            <%= form.text_area :content,
                rows: 4,
                placeholder: "Write your review...",
                class: "w-full rounded-lg border border-gray-300 px-4 py-2" %>
          </div>

          <%= form.submit "Submit Review",
              class: "rounded-lg bg-blue-600 px-5 py-2 text-white hover:bg-blue-700 cursor-pointer" %>

        </div>
      <% end %>
    <% else %>
      <p class="text-gray-600">
        Please <%= link_to "log in", login_path, class: "text-blue-600 underline" %>
        to write a review.
      </p>
    <% end %>

  </div>
</div>

<!-- Display Reviews -->
<div class="max-w-5xl mx-auto px-10 pb-10">

  <h2 class="text-2xl font-bold mb-5">
    Reviews (<%= @reviews.count %>)
  </h2>

  <% if @reviews.any? %>

    <% @reviews.each do |review| %>

      <div class="mb-5 rounded-xl border border-gray-200 bg-white p-4">

        <div class="flex items-center justify-between">

          <h3 class="font-semibold text-gray-900">
            <%= review.user.name %>
          </h3>

          <p class="text-sm text-gray-500">
            <%= review.created_at.strftime("%B %d, %Y") %>
          </p>

        </div>

        <p class="mt-3 text-gray-700 whitespace-pre-line">
          <%= review.content %>
        </p>

        <% if current_user && review.user == current_user %>
  <div class="mt-4 flex gap-3 items-center">

    <%= link_to "Edit",
    edit_movie_review_path(@movie, review),
    class: "rounded-lg bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700 hover:bg-blue-200 transition" %>

    <%= button_to "Delete",
    movie_review_path(@movie, review),
    method: :delete,
    class: "rounded-lg bg-red-100 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-200 transition cursor-pointer",
    form: { data: { turbo_confirm: "Are you sure you want to delete this review?" } } %>

  </div>
<% end %>

      </div>

    <% end %>

  <% else %>

    <p class="text-gray-500">
      No reviews yet. Be the first to review this movie!
    </p>

  <% end %>

</div>