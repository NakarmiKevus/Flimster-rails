<div class="max-w-7xl mx-auto p-10">

  <!-- Welcome Section -->
  <h1 class="text-4xl font-bold text-gray-900 text-center">
    Welcome to Filmster 🎬
  </h1>

  <p class="mt-3 text-gray-600 text-center">
    Discover movies and share your reviews.
  </p>

  <!-- Main Content -->
  <div class="flex gap-8 mt-10 items-start">

    <!-- Left Side: Search + Reviews -->
    <div class="w-1/3 sticky top-24">

      <!-- Search -->
      <%= form_with url: search_movies_path, method: :get, class: "flex gap-3" do |form| %>

        <%= form.text_field :q,
            placeholder: "Search movies...",
            class: "flex-1 min-w-0 border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>

        <%= form.submit "Search",
            class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 cursor-pointer" %>

      <% end %>

      <!-- Reviews -->
      <div class="mt-8">

        <h2 class="text-2xl font-bold text-gray-900 mb-5">
          Latest Reviews
        </h2>

        <div class="space-y-4">

          <% @reviews.each do |review| %>

            <div class="rounded-xl border border-gray-200 bg-white p-4">

              <h3 class="font-semibold text-gray-900">
                <%= review.user.name.capitalize %>
              </h3>

              <p class="text-sm text-blue-600 mt-1">
                <%= review.movie.title %>
              </p>

              <p class="text-sm text-gray-600 mt-3">
                <%= review.content %>
              </p>

            </div>

          <% end %>

        </div>

      </div>

    </div>

    <!-- Right Side: Movies -->
    <div class="w-2/3">

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4">

        <% @movies.each do |movie| %>
          <%= render "movies/movie_card", movie: movie %>
        <% end %>

      </div>

    </div>

  </div>

</div>