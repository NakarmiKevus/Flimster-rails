<div class="min-h-screen bg-gray-50 px-4 py-12">
  <div class="mx-auto max-w-2xl rounded-xl border border-gray-200 bg-white p-4 shadow-sm">

    <h1 class="mb-6 text-2xl font-bold text-gray-900">
      Edit Your Review
    </h1>

    <%= form_with model: [@movie, @review] do |form| %>

      <div class="space-y-4">

        <div>
          <%= form.label :content, "Your Review",
              class: "mb-2 block font-medium text-gray-700" %>

          <%= form.text_area :content,
              rows: 6,
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-blue-500 focus:outline-none" %>
        </div>

        <div class="flex items-center gap-3">

          <%= form.submit "Update Review",
              class: "cursor-pointer rounded-lg bg-blue-600 px-5 py-2.5 font-semibold text-white hover:bg-blue-700" %>

          <%= link_to "Cancel",
              movie_path(@movie),
              class: "rounded-lg border border-gray-300 px-5 py-2.5 text-gray-700 hover:bg-gray-50" %>

        </div>

      </div>

    <% end %>

  </div>
</div>