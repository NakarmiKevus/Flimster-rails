
<div class="min-h-screen bg-gray-50 px-4 py-12">
  <div class="mx-auto max-w-3xl">

    <% if notice.present? %>
      <div class="mb-6 rounded-lg bg-green-100 px-4 py-3 text-sm text-green-800">
        <%= notice %>
      </div>
    <% end %>

    <!-- Profile Card -->
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

      <!-- Cover -->
      <div class="h-40 bg-gradient-to-r from-gray-900 via-gray-700 to-gray-900"></div>

      <!-- Profile Information -->
      <div class="px-6 pb-8">

        <div class="-mt-14 mb-6 flex items-end justify-between">
          <div class="flex h-28 w-28 items-center justify-center rounded-full border-4 border-white bg-red-600 text-4xl font-bold text-white shadow">
            <%= @user.name.to_s.first&.upcase || "U" %>
          </div>

          <%= link_to "Edit Profile", edit_user_path(@user),
              class: "rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 transition" %>
        </div>

        <h1 class="text-3xl font-bold text-gray-900">
          <%= @user.name.capitalize %>
        </h1>

        <p class="mt-2 text-gray-500">
          <%= @user.email %>show
        </p>

        <div class="mt-6 border-t border-gray-200 pt-6">
          <h2 class="text-lg font-semibold text-gray-900">
            Account Information
          </h2>

          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">

            <div class="rounded-xl bg-gray-50 p-4">
              <p class="text-sm text-gray-500">Full Name</p>
              <p class="mt-1 font-medium text-gray-900"><%= @user.name.capitalize %></p>
            </div>

            <div class="rounded-xl bg-gray-50 p-4">
              <p class="text-sm text-gray-500">Email Address</p>
              <p class="mt-1 font-medium text-gray-900 break-all"><%= @user.email %></p>
            </div>

            <div class="rounded-xl bg-gray-50 p-4">
              <p class="text-sm text-gray-500">Member Since</p>
              <p class="mt-1 font-medium text-gray-900"><%= @user.created_at.strftime("%B %Y") %></p>
            </div>

          </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 pt-6">

          <%= link_to "← Back to Home", root_path,
              class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>

          <%= button_to "Delete Account", @user,
              method: :delete,
              class: "rounded-lg border border-red-200 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 transition",
              form: { data: { turbo_confirm: "Are you sure you want to delete your account?" } } %>

        </div>

      </div>
    </div>

  </div>
</div>
